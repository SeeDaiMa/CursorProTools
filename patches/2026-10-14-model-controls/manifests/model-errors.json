      "old": "isModelSwitchRequired:!1,isLimitHitBubble:!1,isHardBlockLimitHitBubble:!1,",
      "new": "isModelSwitchRequired:!1,isLimitHitBubble:!1,isHardBlockLimitHitBubble:!1,isInputRetryableError:!1,"
    },
    {
      "label": "followup chrome consumes error owner classification",
      "old": "dismissUsageLimitForRetry:()=>{if(Lx.visible&&Lx.isHardBlockLimitHitBubble)Lx.onDismiss?.()},hasActiveHardBlockLimitHitBubble:Lx.visible&&Lx.isHardBlockLimitHitBubble,",
      "new": "dismissInputErrorForRetry:()=>{if(Lx.visible&&Lx.isInputRetryableError)Lx.onDismiss?.()},hasActiveInputRetryableError:Lx.visible&&Lx.isInputRetryableError,hasActiveHardBlockLimitHitBubble:Lx.visible&&Lx.isHardBlockLimitHitBubble,"
